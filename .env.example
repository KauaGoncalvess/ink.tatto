# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Aponte para o seu Postgres (Neon, Supabase, Railway, RDS ou local).
DATABASE_URL="postgresql://inkhouse:inkhouse@127.0.0.1:5432/inkhouse?schema=public"

# ---------------------------------------------------------------------------
# Autenticação do painel administrativo
# ---------------------------------------------------------------------------
# Segredo de assinatura do JWT de sessão. Gere um novo com:
#   openssl rand -base64 48
# NUNCA reutilize o valor de exemplo em produção.
AUTH_SECRET="troque-este-valor-por-uma-chave-aleatoria-de-no-minimo-32-bytes"

# Duração da sessão em horas.
AUTH_SESSION_HOURS="12"

# Credenciais do administrador criado pelo seed.
# Troque a senha no primeiro acesso.
SEED_ADMIN_EMAIL="admin@inkhouse.studio"
SEED_ADMIN_PASSWORD="InkHouse@2026"
SEED_ADMIN_NAME="Administração Ink House"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# URL pública canônica — usada em metadata, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Uploads de imagem (opcional)
# ---------------------------------------------------------------------------
# "local" grava em public/uploads — serve para desenvolvimento e para um único
# servidor com disco persistente. Em plataformas com sistema de arquivos
# efêmero (Vercel, Cloud Run) as imagens somem no próximo deploy: use "s3".
STORAGE_DRIVER="local"

# Preenchidos só quando STORAGE_DRIVER="s3". Funciona com S3, R2, Backblaze B2
# e qualquer serviço compatível — a assinatura é SigV4 padrão.
# S3_BUCKET="ink-house-uploads"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Endpoint só para provedores não-AWS. Ex.: https://<conta>.r2.cloudflarestorage.com
# S3_ENDPOINT=""
# Base pública de leitura dos arquivos (CDN ou domínio do bucket).
# S3_PUBLIC_URL="https://cdn.seu-dominio.com.br"

# ---------------------------------------------------------------------------
# Rate limit (opcional)
# ---------------------------------------------------------------------------
# Sem estas variáveis o limite é contado em memória, o que basta para uma
# única instância. Com mais de uma, cada processo teria a própria contagem e o
# limite efetivo viraria N vezes o configurado — aí o Redis passa a ser
# necessário. Aceita o REST do Upstash.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# E-mail (opcional)
# ---------------------------------------------------------------------------
# Sem RESEND_API_KEY as notificações ficam apenas no painel (tabela
# Notification) — nada quebra, só não sai e-mail. Com a chave, o cliente
# recebe o comprovante do agendamento e o estúdio recebe o aviso.
# RESEND_API_KEY=""
# Remetente verificado no provedor. Ex.: "Ink House <contato@seu-dominio.com.br>"
# EMAIL_FROM=""
